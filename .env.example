# Base URL of the ChromaBack API. It owns the Google OAuth flow
# (authorization-code): GET /google/login starts the redirect, GET
# /google/callback exchanges the code. See docs/google-oauth-setup.md.
# Read on the client via $env/static/public, so the key must exist at
# build/check time or svelte-check / vite build fail.
PUBLIC_API_BASE_URL=http://localhost:3000
